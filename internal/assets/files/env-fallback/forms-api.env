PORT=3006
MONGO_URI=mongodb://ipalpha:ipalpha@127.0.0.1:27017/forms?authSource=admin
REDIS_URL=redis://127.0.0.1:6379
RABBITMQ_URL=amqp://ipalpha:ipalpha@127.0.0.1:5672/
AUTH_API_URL=http://127.0.0.1:3005
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
PROJECTS_API_URL=http://127.0.0.1:3001
PROJECT_CONTENT_ORIGINS=http://localhost:5110,http://localhost:5106
FORMS_RESPONDENT_LOGIN_ENTRY_POINT_ID=ep-ipalpha-forms-respondent-login
EXCHANGE_FORMS_RESPONSE_CREATED=forms-api.response.created
EXCHANGE_FORMS_PERSON_REQUESTED=forms-api.person.requested
SUBMIT_RATE_LIMIT=20
API_PUBLIC_URL=http://127.0.0.1:3006
PERSONS_API_URL=http://127.0.0.1:3002
# Confidential respondent client: equal to auth-api BUILTIN_FORMS_RESPONDENT_CLIENT_ID / _SECRET.
FORMS_RESPONDENT_CLIENT_ID=forms-respondent-web
FORMS_RESPONDENT_CLIENT_SECRET=dev-forms-respondent-secret-change-me
FORMS_RESPONDENT_ENTRY_POINT=respondent
FORMS_RESPONDENT_REDIRECT_URI=http://localhost:5106/respond/callback
FORM_RESPONSE_RECEIPT_TTL_SEC=1800
TRUST_PROXY_HOPS=1
# Sample data: owned by the workspace choice seed=on|off (ipalpha config set seed on|off). Never set by hand.
SEED_DATA=
IPALPHA_ENV=
SEED_KEY=
