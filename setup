#!/usr/bin/env bash
set -euo pipefail

ipalpha_setup_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/common.sh
source "$ipalpha_setup_root/lib/common.sh"
# shellcheck source=lib/i18n.sh
source "$ipalpha_setup_root/lib/i18n.sh"
# shellcheck source=lib/tools.sh
source "$ipalpha_setup_root/lib/tools.sh"
# shellcheck source=lib/clone.sh
source "$ipalpha_setup_root/lib/clone.sh"
# shellcheck source=lib/env.sh
source "$ipalpha_setup_root/lib/env.sh"
# shellcheck source=lib/ports.sh
source "$ipalpha_setup_root/lib/ports.sh"
# shellcheck source=lib/settings.sh
source "$ipalpha_setup_root/lib/settings.sh"
# shellcheck source=lib/generate.sh
source "$ipalpha_setup_root/lib/generate.sh"

ipalpha_skip_tools=false
ipalpha_keep_setup=false

for arg in "$@"; do
  case "$arg" in
    --skip-tools) ipalpha_skip_tools=true ;;
    --keep-setup) ipalpha_keep_setup=true ;;
    --help|-h)
      echo "Usage: setup [--skip-tools] [--keep-setup]"
      echo "  --skip-tools   skip tool auto-install (for tests)"
      echo "  --keep-setup   do not delete this .github clone after setup"
      exit 0
      ;;
  esac
done

if [[ -n "${IPALPHA_LANG:-}" ]]; then
  ipalpha_i18n_init "$IPALPHA_LANG"
else
  ipalpha_prompt_language
fi

if [[ -n "${IPALPHA_TARGET_DIR:-}" ]]; then
  ipalpha_target_root="$IPALPHA_TARGET_DIR"
else
  default_root="${IPALPHA_DEFAULT_ROOT:-$PWD/IpAlpha}"
  echo
  echo "$(ipalpha_msg target_folder)"
  echo "  $(ipalpha_msg target_prompt): $default_root"
  read -r answer </dev/tty 2>/dev/null || answer=""
  ipalpha_target_root="${answer:-$default_root}"
fi
mkdir -p "$ipalpha_target_root"
ipalpha_target_root="$(cd "$ipalpha_target_root" && pwd)"
echo "  → $ipalpha_target_root"

if [[ "$ipalpha_skip_tools" != true ]]; then
  ipalpha_ensure_tools
else
  ipalpha_detect_runtime
  ipalpha_runtime="${ipalpha_runtime:-docker}"
  ipalpha_runner="${ipalpha_runner:-auto}"
fi

ipalpha_ai_cli="${IPALPHA_AI_CLI:-}"
ipalpha_ai_model="${IPALPHA_AI_MODEL:-}"
if [[ -z "$ipalpha_ai_cli" ]]; then
  if command -v pi >/dev/null 2>&1; then
    ipalpha_ai_cli="pi"
    ipalpha_ai_model="${ipalpha_ai_model:-cpamc/muse-spark-1.3-contributor}"
  elif command -v claude >/dev/null 2>&1; then
    ipalpha_ai_cli="claude"
  elif command -v grok >/dev/null 2>&1; then
    ipalpha_ai_cli="grok"
  elif command -v codex >/dev/null 2>&1; then
    ipalpha_ai_cli="codex"
  else
    ipalpha_ai_cli="pi"
    ipalpha_ai_model="${ipalpha_ai_model:-cpamc/muse-spark-1.3-contributor}"
  fi
fi
echo "  $(ipalpha_msg ai_selected): $ipalpha_ai_cli${ipalpha_ai_model:+ / $ipalpha_ai_model}"

ipalpha_clone_org_repos "$ipalpha_target_root"

ipalpha_fallback_env="$ipalpha_setup_root/templates/env-fallback"
for repo in "${ipalpha_ms_repos[@]}"; do
  ipalpha_install_repo_env "$(ipalpha_repo_path "$ipalpha_target_root" "$repo")" "$repo" "$ipalpha_fallback_env"
done

ipalpha_resolve_ports
ipalpha_apply_port_rewrites "$ipalpha_target_root"
ipalpha_seed_local_clients "$ipalpha_target_root"

if [[ "${IPALPHA_SKIP_INSTALL:-}" != "1" ]]; then
  for repo in "${ipalpha_ms_repos[@]}"; do
    dir="$(ipalpha_repo_path "$ipalpha_target_root" "$repo")"
    if [[ -f "$dir/package.json" ]]; then
      echo "  $(ipalpha_msg app_deps): $repo"
      (cd "$dir" && npm install --no-audit --no-fund --silent) || true
    fi
  done
fi

ipalpha_materialize_workspace "$ipalpha_setup_root" "$ipalpha_target_root"
cp "$ipalpha_setup_root/set-keys" "$ipalpha_target_root/set-keys" && chmod +x "$ipalpha_target_root/set-keys"

if [[ "$ipalpha_keep_setup" != true && "$(basename "$ipalpha_setup_root")" == "$ipalpha_tooling_repo" \
      && "$ipalpha_target_root" != "$ipalpha_setup_root"* ]]; then
  echo "$(ipalpha_msg cleanup): $ipalpha_setup_root"
  rm -rf "$ipalpha_setup_root"
fi

echo
echo "$(ipalpha_msg done)"
echo "  $(ipalpha_msg done_in): $ipalpha_target_root"
echo "  $(ipalpha_msg done_run_now) ./run"
echo

if [[ -t 0 && -z "${IPALPHA_NO_SHELL:-}" && "$ipalpha_skip_tools" != true ]]; then
  cd "$ipalpha_target_root"
  exec "${SHELL:-/bin/bash}" -i
fi
